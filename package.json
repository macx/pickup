{
  "name": "pickup-release-tooling",
  "version": "0.2.1",
  "private": true,
  "description": "Release-only tooling for Pickup (release-it). The app itself has no Node or other runtime dependencies.",
  "license": "MIT",
  "author": "David Eiken",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "release": "release-it",
    "release:dry-run": "release-it --dry-run --ci",
    "release:next-version": "release-it --release-version --ci",
    "release:changelog": "release-it --changelog --ci",
    "commits:check": "scripts/check-conventional-commits.sh",
    "package:dry-run": "scripts/package-release.sh --dry-run"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.2",
    "release-it": "21.1.0"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
