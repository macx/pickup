{
  "$schema": "https://unpkg.com/release-it@21.1.0/schema/release-it.json",
  "git": {
    "requireBranch": "release/*",
    "requireCleanWorkingDir": true,
    "requireUpstream": false,
    "requireCommits": true,
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "tag": false,
    "push": false
  },
  "github": {
    "release": false
  },
  "npm": false,
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits",
        "preMajor": true
      },
      "infile": "CHANGELOG.md",
      "header": "# Changelog"
    }
  },
  "hooks": {
    "before:init": "scripts/set-version.sh --check",
    "after:bump": [
      "scripts/set-version.sh ${version}",
      "scripts/set-version.sh --check"
    ]
  }
}
