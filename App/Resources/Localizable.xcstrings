            "state": "translated",
            "value": "Zurückrufen"
          }
        }
      }
    },
    "%@, missed calls": {
      "comment": "Accessibility label of the menu bar icon while it shows the red dot for missed calls. %@ is the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
