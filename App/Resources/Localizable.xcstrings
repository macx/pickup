          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen"
          }
        }
      }
    },
    "Allow": {
      "comment": "Welcome window: button that asks macOS for a permission.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben"
          }
        }
      }
    },
    "Open Settings…": {
      "comment": "Welcome window: button that opens the matching privacy pane in System Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen …"
          }
        }
      }
    },
    "Welcome to Pickup": {
      "comment": "Title of the welcome window (window title, read by VoiceOver).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Pickup"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei Pickup"
          }
        }
      }
    },
    "Pickup was updated": {
      "comment": "Title of the welcome window after an update of an unsigned build.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup was updated"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup wurde aktualisiert"
          }
        }
      }
    },
    "On this Mac": {
      "comment": "Welcome window: section header for the permissions on the Mac.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac"
          }
        }
      }
    },
    "On your phone": {
      "comment": "Welcome window: section header for the permissions on the Android phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your phone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Telefon"
          }
        }
      }
    },
    "Phone calls and call history": {
      "comment": "Welcome window: title of the row about the permissions on the Android phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone calls and call history"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonanrufe und Anrufliste"
          }
        }
      }
    },
    "In the phone’s Bluetooth settings, open this Mac and allow “Phone calls” and “Contacts and call history”. Without the call history, Pickup lists only the calls since it started.": {
      "comment": "Welcome window: what to allow on the Android phone (Pixel wording: Phone calls, Contacts and call history).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the phone’s Bluetooth settings, open this Mac and allow “Phone calls” and “Contacts and call history”. Without the call history, Pickup lists only the calls since it started."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in den Bluetooth-Einstellungen des Telefons diesen Mac und erlaube „Telefonanrufe“ und „Kontakte und Anrufliste“. Ohne die Anrufliste zeigt Pickup nur die Anrufe seit dem Start."
          }
        }
      }
    },
    "Pickup isn’t signed by Apple yet, so macOS treats every update like a new app and may ask for its permissions again. Here you see them all at a glance.": {
      "comment": "Welcome window text after an update of a build without an Apple Developer ID signature.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup isn’t signed by Apple yet, so macOS treats every update like a new app and may ask for its permissions again. Here you see them all at a glance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup ist noch nicht von Apple signiert. macOS behandelt deshalb jedes Update wie eine neue App und fragt die Freigaben eventuell erneut ab. Hier siehst du alle auf einen Blick."
          }
        }
      }
    },
    "Pickup isn’t signed by Apple yet. After an update, macOS may ask again; this window then helps you.": {
      "comment": "Small note at the bottom of the welcome window for builds without an Apple Developer ID signature.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup isn’t signed by Apple yet. After an update, macOS may ask again; this window then helps you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup ist noch nicht von Apple signiert. Nach einem Update fragt macOS eventuell erneut; dann hilft dir dieses Fenster."
          }
        }
      }
    },
    "Pair it in System Settings › Bluetooth first, then choose it in Pickup.": {
      "comment": "Welcome window: how to set up the phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair it in System Settings › Bluetooth first, then choose it in Pickup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopple es zuerst in den Systemeinstellungen › Bluetooth und wähle es dann in Pickup aus."
          }
        }
      }
    },
    "Needed to connect to your phone.": {
      "comment": "Welcome window: why Pickup needs Bluetooth.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed to connect to your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig für die Verbindung zu deinem Telefon."
          }
        }
      }
    },
    "Asked when connecting": {
      "comment": "Welcome window: macOS asks for Bluetooth the first time Pickup connects to the phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked when connecting"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Verbinden abgefragt"
          }
        }
      }
    },
    "Shows names and photos and lets you search your contacts. Optional.": {
      "comment": "Welcome window: why Pickup asks for Contacts access.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows names and photos and lets you search your contacts. Optional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Namen und Fotos und ermöglicht die Suche in deinen Kontakten. Optional."
          }
        }
      }
    },
    "Tells you about missed calls, with “Call Back”. Optional.": {
      "comment": "Welcome window: why Pickup asks to send notifications.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you about missed calls, with “Call Back”. Optional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet verpasste Anrufe, mit „Zurückrufen“. Optional."
          }
        }
      }
    },
    "Welcome to Pickup!": {
      "comment": "Headline of the welcome window at the first launch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Pickup!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei Pickup!"
          }
        }
      }
    },
    "Loading recent calls": {
      "comment": "VoiceOver label of the placeholder rows shown while the recent calls are read from the phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading recent calls"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Anrufe werden geladen"
          }
        }
      }
    },
    "Recent calls aren’t available right now.": {
      "comment": "Shown instead of the recent calls when the phone has not sent them within 10 seconds or did not answer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent calls aren’t available right now."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten Anrufe sind gerade nicht verfügbar."
          }
        }
      }
    },
    "Pickup controls the incoming and outgoing calls of your Android phone, much like Continuity does for the iPhone. The conversation stays on your phone. Check the permissions below once, then you’re ready.": {
      "comment": "Welcome window text at the first launch. Continuity is Apple’s name for the iPhone feature; keep it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup controls the incoming and outgoing calls of your Android phone, much like Continuity does for the iPhone. The conversation stays on your phone. Check the permissions below once, then you’re ready."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Pickup steuerst du deine ein- und ausgehenden Anrufe deines Android-Smartphones, ähnlich wie das Apple beim iPhone mit Continuity macht. Das Gespräch selbst bleibt dabei aber auf deinem Telefon. Bitte prüfe einmal die Freigaben unten, dann kann es losgehen."
          }
        }
      }
    }
  },
  "version": "1.0"
}