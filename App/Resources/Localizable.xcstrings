            "state": "translated",
            "value": "Zu %@ wechseln"
          }
        }
      }
    },
    "End call with %@": {
      "comment": "VoiceOver label of the button that ends the call on hold. %@ is the caller's name or number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End call with %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf mit %@ beenden"
          }
        }
      }
    },
    "Hold & Accept": {
      "comment": "Button in the call window when a second call comes in: puts the current call on hold and answers the new one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold & Accept"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten und annehmen"
          }
        }
      }
    },
    "End & Accept": {
      "comment": "Button in the call window when a second call comes in: ends the current call and answers the new one.",
