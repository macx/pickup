            "state": "translated",
            "value": "%1$@, Akku des Telefons %2$@"
          }
        }
      }
    },
    "Phone battery": {
      "comment": "Settings: where the phone's battery charge is shown. Also the VoiceOver label of the battery gauge in the popover.",
      "extractionState": "manual",
      "localizations": {
