{
  "sourceLanguage": "en",
  "strings": {
    "Connected to %@": {
      "comment": "Menu bar status line. %@ is the phone name, e.g. \"Pixel 9 Pro\".",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden mit %@"
          }
        }
      }
    },
    "No phone selected": {
      "comment": "Menu bar status line when no phone has been chosen yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No phone selected"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Telefon ausgewählt"
          }
        }
      }
    },
    "Settings…": {
      "comment": "Menu item that opens the Settings window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen …"
          }
        }
      }
    },
    "Quit Pickup": {
      "comment": "Menu item that quits the app. Pickup is the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Pickup"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup beenden"
          }
        }
      }
    },
    "Incoming call on %@": {
      "comment": "Caption in the incoming-call banner. %@ is the phone name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming call on %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingehender Anruf auf %@"
          }
        }
      }
    },
    "Unknown caller": {
      "comment": "Shown instead of a name when the caller number is not available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown caller"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannter Anrufer"
          }
        }
      }
    },
    "Accept": {
      "comment": "Green button that accepts an incoming call. Keep it short.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Annehmen"
          }
        }
      }
    },
    "Decline": {
      "comment": "Red button that rejects an incoming call. Keep it short.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ablehnen"
          }
        }
      }
    },
    "Accept call": {
      "comment": "VoiceOver label of the Accept button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept call"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf annehmen"
          }
        }
      }
    },
    "Decline call": {
      "comment": "VoiceOver label of the Decline button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline call"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf ablehnen"
          }
        }
      }
    },
    "Incoming call from %@": {
      "comment": "VoiceOver label of the incoming-call banner. %@ is the caller name or number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming call from %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingehender Anruf von %@"
          }
        }
      }
    },
    "Calling…": {
      "comment": "Status in the call window while an outgoing call is being set up.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calling…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf läuft …"
          }
        }
      }
    },
    "Call with %@": {
      "comment": "VoiceOver label of the call window header. %@ is the other party.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call with %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf mit %@"
          }
        }
      }
    },
    "Call duration": {
      "comment": "VoiceOver label of the running call timer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call duration"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufdauer"
          }
        }
      }
    },
    "Mute": {
      "comment": "Button that mutes the Mac microphone during a call. Keep it short.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stumm"
          }
        }
      }
    },
    "Unmute": {
      "comment": "VoiceOver label while the microphone is muted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmute"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stummschaltung aufheben"
          }
        }
      }
    },
    "Keypad": {
      "comment": "Button that shows the dial pad during a call. Keep it short.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keypad"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenfeld"
          }
        }
      }
    },
    "Hide Keypad": {
      "comment": "VoiceOver label while the dial pad is visible.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Keypad"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenfeld ausblenden"
          }
        }
      }
    },
    "Move to Phone": {
      "comment": "Button that moves the call audio back to the phone. Keep it short; it is shown under a round button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Phone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Telefon"
          }
        }
      }
    },
    "Move call to phone": {
      "comment": "VoiceOver label of the Move to Phone button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move call to phone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf auf das Telefon übertragen"
          }
        }
      }
    },
    "End Call": {
      "comment": "Red button that ends the call.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End Call"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auflegen"
          }
        }
      }
    },
    "Call audio is on %@": {
      "comment": "Caption in the call window in remote-control mode. %@ is the phone name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call audio is on %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf-Audio läuft auf %@"
          }
        }
      }
    },
    "Phone": {
      "comment": "Settings section header.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon"
          }
        }
      }
    },
    "Take calls on this Mac": {
      "comment": "Toggle: use the Mac microphone and speakers for calls. Disabled until the feature ships.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take calls on this Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufe an diesem Mac führen"
          }
        }
      }
    },
    "Launch at login": {
      "comment": "Toggle: start Pickup automatically when the user logs in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at login"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anmelden öffnen"
          }
        }
      }
    },
    "Pickup needs your approval in System Settings > General > Login Items.": {
      "comment": "Caption shown when the system requires approval for the login item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup needs your approval in System Settings > General > Login Items."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup benötigt deine Bestätigung in den Systemeinstellungen unter „Allgemein“ > „Anmeldeobjekte“."
          }
        }
      }
    },
    "Open Login Items Settings…": {
      "comment": "Button that opens the Login Items pane of System Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Login Items Settings…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldeobjekte öffnen …"
          }
        }
      }
    },
    "Could not change the login item setting.": {
      "comment": "Error caption shown when registering the login item failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not change the login item setting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellung für das Anmeldeobjekt konnte nicht geändert werden."
          }
        }
      }
    },
    "Pickup": {
      "comment": "Name of the app (menu bar icon accessibility label).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup"
          }
        }
      }
    },
    "Missed call": {
      "comment": "Call window status and notification title: an incoming call stopped ringing unanswered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missed call"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verpasster Anruf"
          }
        }
      }
    },
    "Call declined": {
      "comment": "Call window status: the user declined an incoming call on the Mac.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call declined"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf abgelehnt"
          }
        }
      }
    },
    "Call cancelled": {
      "comment": "Call window status: the user cancelled an outgoing call before it was answered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call cancelled"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf abgebrochen"
          }
        }
      }
    },
    "No answer": {
      "comment": "Call window status: an outgoing call was not answered (busy, rejected or no answer).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Antwort"
          }
        }
      }
    },
    "Call could not be placed": {
      "comment": "Call window status: the phone did not start the outgoing call.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call could not be placed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf konnte nicht gestartet werden"
          }
        }
      }
    },
    "Call ended": {
      "comment": "Call window status: the call is over.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call ended"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anruf beendet"
          }
        }
      }
    },
    "Connection to phone lost": {
      "comment": "Call window status: the Bluetooth link dropped; the call may still run on the phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection to phone lost"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zum Telefon verloren"
          }
        }
      }
    },
    "Call audio could not be started on this Mac. It stays on your phone.": {
      "comment": "Notice in the call window after the audio connection to the Mac timed out.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call audio could not be started on this Mac. It stays on your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anruf-Audio konnte auf diesem Mac nicht gestartet werden. Es bleibt auf deinem Telefon."
          }
        }
      }
    },
    "Call audio on this Mac was interrupted. It moved back to your phone.": {
      "comment": "Notice in the call window after the audio connection to the Mac dropped during a call.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call audio on this Mac was interrupted. It moved back to your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anruf-Audio auf diesem Mac wurde unterbrochen. Es läuft wieder auf deinem Telefon."
          }
        }
      }
    },
    "Call audio moved to your phone.": {
      "comment": "Notice in the call window after the user chose Move to Phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call audio moved to your phone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anruf-Audio wurde auf dein Telefon verlegt."
          }
        }
      }
    },
    "Your phone is not connected.": {
      "comment": "Error when a call action needs a Bluetooth connection that is not up.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone is not connected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Telefon ist nicht verbunden."
          }
        }
      }
    },
    "That is not possible right now.": {
      "comment": "Error when a call action does not fit the current call state, e.g. answering when nothing rings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not possible right now."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist gerade nicht möglich."
          }
        }
      }
    },
    "Another call is already in progress.": {
      "comment": "Error when dialing while a call is live.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another call is already in progress."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es läuft bereits ein anderer Anruf."
          }
        }
      }
    },
    "Your phone does not support this.": {
      "comment": "Error when the phone or transport cannot do the requested action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone does not support this."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Telefon unterstützt das nicht."
          }
        }
      }
    },
    "Your phone could not carry out that action.": {
      "comment": "Notice when the phone answered a call command (answer, hang up, dial) with an error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone could not carry out that action."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Telefon konnte diese Aktion nicht ausführen."
          }
        }
      }
    },
    "your phone": {
      "comment": "Fallback for the phone's name, used mid-sentence after \"on\"/\"auf\", e.g. \"Call audio is on your phone\"/\"Anruf-Audio läuft auf Ihrem Telefon\". German must be dative.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "your phone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "deinem Telefon"
          }
        }
      }
    },
    "This phone link cannot be used.": {
      "comment": "Alert title when a tel: or callto: link has no valid number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone link cannot be used."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Telefonlink kann nicht verwendet werden."
          }
        }
      }
    },
    "The link does not contain a valid phone number.": {
      "comment": "Alert detail for an invalid tel: link.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link does not contain a valid phone number."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link enthält keine gültige Telefonnummer."
          }
        }
      }
    },
    "Call %@?": {
      "comment": "Confirmation title for a tel: link. %@ is the contact name or the formatted phone number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call %@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ anrufen?"
          }
        }
      }
    },
    "Pickup will place this call on %@.": {
      "comment": "Confirmation detail for a tel: link. %@ is the phone name, or \"your phone\" (dative in German).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup will place this call on %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup startet diesen Anruf auf %@."
          }
        }
      }
    },
    "Call": {
      "comment": "Button that places the call.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufen"
          }
        }
      }
    },
    "Cancel": {
      "comment": "Button that dismisses a dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Choose your phone in Settings first.": {
      "comment": "Alert detail when no phone is selected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your phone in Settings first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zuerst in den Einstellungen dein Telefon aus."
          }
        }
      }
    },
    "OK": {
      "comment": "Button that dismisses an alert.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Ringing…": {
      "comment": "Call window status: the remote party's phone is ringing (outgoing call).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringing…"
          }
        },
