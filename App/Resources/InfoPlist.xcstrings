    "NSBluetoothAlwaysUsageDescription": {
      "comment": "Bluetooth permission prompt text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup uses Bluetooth to connect to your Android phone and control its calls."
