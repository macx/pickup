          "stringUnit": {
            "state": "translated",
            "value": "Pickup looks up the names of callers in your contacts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pickup sucht die Namen von Anrufern in Ihren Kontakten."
