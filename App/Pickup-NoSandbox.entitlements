<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Development/direct-distribution variant: no App Sandbox. A sandboxed app cannot become the
	     default handler for tel: links (NSWorkspace.setDefaultApplication fails with NSCocoaErrorDomain 256). -->
	<key>com.apple.security.device.bluetooth</key><true/>
	<key>com.apple.security.personal-information.addressbook</key><true/>
</dict>
</plist>
